{
  "name": "ai-marketing",
  "version": "1.0.0",
  "description": "AI Marketing Agency Platform",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "cross-env NODE_ENV=development node server/server.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview --host 0.0.0.0",
    "start": "cross-env NODE_ENV=production node server/server.js",
    "test": "echo \"No automated tests configured\" && exit 0"
  },
  "keywords": [
    "marketing",
    "ai",
    "dashboard"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "vite": "^8.3.4"
  }
}
